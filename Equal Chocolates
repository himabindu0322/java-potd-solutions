import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		
		// Read inputs A, X, B, Y
		int A = sc.nextInt();
		int X = sc.nextInt();
		int B = sc.nextInt();
		int Y = sc.nextInt();
		
		// Calculate total chocolates for each type
		int totalFirst = A * X;
		int totalSecond = B * Y;
		
		// Check equality and print the result
		if (totalFirst == totalSecond) {
			System.out.println("YES");
		} else {
			System.out.println("NO");
		}
		
		sc.close();
	}
}
