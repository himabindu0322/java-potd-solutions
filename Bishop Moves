import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		if (sc.hasNextInt()) {
			int t = sc.nextInt();
			
			while (t-- > 0) {
				int x1 = sc.nextInt();
				int y1 = sc.nextInt();
				int x2 = sc.nextInt();
				int y2 = sc.nextInt();
				
				// Check if they are on different colored squares
				if ((x1 + y1) % 2 != (x2 + y2) % 2) {
					System.out.println(-1);
				} 
				// Check if they lie on the same diagonal
				else if ((x1 + y1 == x2 + y2) || (x1 - y1 == x2 - y2)) {
					System.out.println(1);
				} 
				// Otherwise, it can always be reached in 2 moves
				else {
					System.out.println(2);
				}
			}
		}
		sc.close();
	}
}
