import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		if (sc.hasNextInt()) {
			int N = sc.nextInt();
			int remainingSlides = 20 - N;
			System.out.println(remainingSlides);
		}
		sc.close();
	}
}
