class Solution {
    public boolean winnerSquareGame(int n) {
        boolean[] dp = new boolean[n + 1];

        // Bottom-up DP computation
        for (int i = 1; i <= n; i++) {
            for (int k = 1; k * k <= i; k++) {
                if (!dp[i - k * k]) {
                    dp[i] = true; // Found a move that forces opponent to lose
                    break;        // No need to check further moves for state i
                }
            }
        }

        return dp[n];
    }
}
