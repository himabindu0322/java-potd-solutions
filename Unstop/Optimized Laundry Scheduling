import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.IOException;
import java.util.StringTokenizer;
import java.util.PriorityQueue;
import java.util.List;
import java.util.ArrayList;

public class Main {

    static class Pair implements Comparable<Pair> {
        long availableTime;
        long baseTime;

        Pair(long availableTime, long baseTime) {
            this.availableTime = availableTime;
            this.baseTime = baseTime;
        }

        @Override
        public int compareTo(Pair other) {
            return Long.compare(this.availableTime, other.availableTime);
        }
    }

    public static long user_logic(int K, int N, int M, List<Integer> W, List<Integer> D) {
        long[] washTimes = computeEarliestTimes(K, W);
        long[] dryTimes = computeEarliestTimes(K, D);

        long maxTotalTime = 0;
        // Pair earliest finished wash with longest drying duration
        for (int i = 0; i < K; i++) {
            long totalGarmentTime = washTimes[i] + dryTimes[K - 1 - i];
            maxTotalTime = Math.max(maxTotalTime, totalGarmentTime);
        }

        return maxTotalTime;
    }

    private static long[] computeEarliestTimes(int K, List<Integer> machineTimes) {
        PriorityQueue<Pair> pq = new PriorityQueue<>();
        for (int time : machineTimes) {
            pq.add(new Pair(time, time));
        }

        long[] result = new long[K];
        for (int i = 0; i < K; i++) {
            Pair curr = pq.poll();
            result[i] = curr.availableTime;
            // Schedule next garment on the same machine
            pq.add(new Pair(curr.availableTime + curr.baseTime, curr.baseTime));
        }

        return result;
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String firstLine = br.readLine();
        if (firstLine == null || firstLine.trim().isEmpty()) return;

        StringTokenizer st = new StringTokenizer(firstLine);
        int K = Integer.parseInt(st.nextToken());
        int N = Integer.parseInt(st.nextToken());
        int M = Integer.parseInt(st.nextToken());

        List<Integer> W = new ArrayList<>(N);
        st = new StringTokenizer(br.readLine());
        for (int i = 0; i < N; i++) {
            W.add(Integer.parseInt(st.nextToken()));
        }

        List<Integer> D = new ArrayList<>(M);
        st = new StringTokenizer(br.readLine());
        for (int i = 0; i < M; i++) {
            D.add(Integer.parseInt(st.nextToken()));
        }

        long result = user_logic(K, N, M, W, D);
        System.out.println(result);
    }
}
