import java.util.Scanner;

public class Main {
    public static String user_logic(int a, int b, int c, int d) {
        // Convert to long to prevent overflow during addition
        long valA = a, valB = b, valC = c, valD = d;
        long totalSum = valA + valB + valC + valD;

        // If the total sum is odd, we cannot divide it into two equal integer sums
        if (totalSum % 2 != 0) {
            return "NO";
        }

        long target = totalSum / 2;

        // Check if 1 item equals target
        if (valA == target || valB == target || valC == target || valD == target) {
            return "YES";
        }

        // Check if any combination of 2 items equals target
        if ((valA + valB == target) || (valA + valC == target) || (valA + valD == target)) {
            return "YES";
        }

        return "NO";
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int a = scanner.nextInt();
        int b = scanner.nextInt();
        int c = scanner.nextInt();
        int d = scanner.nextInt();
        
        // Call user logic function and print the output
        String result = user_logic(a, b, c, d);
        System.out.println(result);
    }
}
