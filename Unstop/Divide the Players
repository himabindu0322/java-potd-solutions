import java.util.*;

public class Main {
    public static int dividePlayers(int[] arr, int n, int k) {
        int sum = 0;
        for (int num : arr) {
            sum += num;
        }

        int target = sum / 2;
        boolean[] dp = new boolean[target + 1];
        dp[0] = true;

        for (int num : arr) {
            for (int j = target; j >= num; j--) {
                if (dp[j - num]) {
                    dp[j] = true;
                }
            }
        }

        // Find the largest achievable subset sum <= target
        int bestS1 = 0;
        for (int j = target; j >= 0; j--) {
            if (dp[j]) {
                bestS1 = j;
                break;
            }
        }

        // Return minimum absolute difference between two team sums
        return sum - 2 * bestS1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextInt()) {
            int n = sc.nextInt();
            int[] arr = new int[n];
            for (int i = 0; i < n; i++) {
                arr[i] = sc.nextInt();
            }
            int k = sc.nextInt();
            int answer = dividePlayers(arr, n, k);
            if (answer <= k)
                System.out.println("True");
            else
                System.out.println("False");
        }
        sc.close();
    }
}
