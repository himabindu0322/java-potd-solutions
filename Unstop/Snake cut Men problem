import java.util.Scanner;

public class Main {
    private static int totalPaths = 0;
    private static final int[] rowDir = {-1, 1, 0, 0};
    private static final int[] colDir = {0, 0, -1, 1};

    public static int snake_to_man_path(char[][] matrix, int n, int m) {
        int startX = -1, startY = -1;
        int endX = -1, endY = -1;

        // Locate snake 's' and man 'm'
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (matrix[i][j] == 's') {
                    startX = i;
                    startY = j;
                } else if (matrix[i][j] == 'm') {
                    endX = i;
                    endY = j;
                }
            }
        }

        // Return 0 if either snake or man is not present
        if (startX == -1 || endX == -1) {
            return 0;
        }

        boolean[][] visited = new boolean[n][m];
        totalPaths = 0;

        // Start DFS backtracking from snake's location
        dfs(matrix, visited, startX, startY, endX, endY, n, m);

        return totalPaths;
    }

    private static void dfs(char[][] matrix, boolean[][] visited, int r, int c, int targetR, int targetC, int n, int m) {
        // Reached the man
        if (r == targetR && c == targetC) {
            totalPaths++;
            return;
        }

        visited[r][c] = true;

        // Explore all 4 orthogonal directions
        for (int d = 0; d < 4; d++) {
            int newR = r + rowDir[d];
            int newC = c + colDir[d];

            // Check bounds, walls, and visited status
            if (newR >= 0 && newR < n && newC >= 0 && newC < m) {
                if (!visited[newR][newC] && matrix[newR][newC] != 'w') {
                    dfs(matrix, visited, newR, newC, targetR, targetC, n, m);
                }
            }
        }

        // Backtrack
        visited[r][c] = false;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;

        int n = scanner.nextInt();
        int m = scanner.nextInt();

        char[][] matrix = new char[n][m];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                matrix[i][j] = scanner.next().charAt(0);
            }
        }

        int result = snake_to_man_path(matrix, n, m);
        System.out.println(result);
        scanner.close();
    }
}
