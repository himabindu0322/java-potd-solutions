import java.util.Scanner;

public class Main {
    public static int minimum_moves(int n, int[] arr) {
        // If there's only 1 point, 0 moves are needed.
        if (n <= 1) {
            return 0;
        }

        int jumps = 0;
        int currentEnd = 0;
        int maxReach = 0;

        for (int i = 0; i < n - 1; i++) {
            // Update the furthest reachable index from point i
            maxReach = Math.max(maxReach, i + arr[i]);

            // If we reached the end of the range for the current jump
            if (i == currentEnd) {
                jumps++;
                currentEnd = maxReach;

                // If our current reach already covers or exceeds the last point, break early
                if (currentEnd >= n - 1) {
                    break;
                }
            }
        }

        return jumps;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;

        int n = scanner.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = scanner.nextInt();
        }

        int result = minimum_moves(n, arr);
        System.out.println(result);
        scanner.close();
    }
}
