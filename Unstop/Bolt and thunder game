import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();
        scanner.close();
        boolean result = user_logic(n);
        System.out.println(result ? "True" : "False");
    }

    public static boolean user_logic(int n) {
        // dp[i] will store true if the player starting with 'i' stones wins
        boolean[] dp = new boolean[n + 1];

        // Fill the DP table from 1 to n
        for (int i = 1; i <= n; i++) {
            // Try removing every possible non-zero square number <= i
            for (int k = 1; k * k <= i; k++) {
                int square = k * k;
                
                // If the state after taking 'square' stones is a losing state for the next player,
                // then the current player wins!
                if (!dp[i - square]) {
                    dp[i] = true;
                    break; // No need to check further square moves for this 'i'
                }
            }
        }

        return dp[n];
    }
}
