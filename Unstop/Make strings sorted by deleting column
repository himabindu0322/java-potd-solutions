import java.util.*;

public class Main {
    static void solve(List<String> strs) {
        if (strs == null || strs.isEmpty()) {
            System.out.println(0);
            return;
        }

        int n = strs.size();
        int L = strs.get(0).length();

        // dp[j] = max valid subsequence length of columns ending at index j
        int[] dp = new int[L];
        Arrays.fill(dp, 1);

        int maxKeep = 1;

        for (int j = 0; j < L; j++) {
            for (int p = 0; p < j; p++) {
                // Check if column p can precede column j for ALL strings
                boolean isValid = true;
                for (int i = 0; i < n; i++) {
                    if (strs.get(i).charAt(p) > strs.get(i).charAt(j)) {
                        isValid = false;
                        break;
                    }
                }

                if (isValid) {
                    dp[j] = Math.max(dp[j], dp[p] + 1);
                }
            }
            maxKeep = Math.max(maxKeep, dp[j]);
        }

        // Minimum deletions required = Total columns - Maximum kept columns
        System.out.println(L - maxKeep);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int n = scanner.nextInt();
            List<String> strs = new ArrayList<>();
            for (int i = 0; i < n; i++) {
                if (scanner.hasNext()) {
                    strs.add(scanner.next());
                }
            }

            solve(strs);
        }
        scanner.close();
    }
}
