import java.util.Scanner;

public class Main {
    static final int MOD = 1000000007;

    public static int count_248_numbers(int N) {
        return (int) (dfs(0, 0, 0, 0, N) % MOD);
    }

    private static long dfs(long currentNum, int count2, int count4, int count8, int maxN) {
        long validCount = 0;

        // Check if the current number meets the 248 condition
        if (currentNum > 0 && count2 >= 1 && count2 == count4 && count4 == count8) {
            validCount++;
        }

        // Try appending all digits from 0 to 9
        for (int digit = 0; digit <= 9; digit++) {
            // Avoid leading zeros
            if (currentNum == 0 && digit == 0) {
                continue;
            }

            long nextNum = currentNum * 10 + digit;
            if (nextNum > maxN) {
                continue;
            }

            int nextC2 = count2 + (digit == 2 ? 1 : 0);
            int nextC4 = count4 + (digit == 4 ? 1 : 0);
            int nextC8 = count8 + (digit == 8 ? 1 : 0);

            validCount = (validCount + dfs(nextNum, nextC2, nextC4, nextC8, maxN)) % MOD;
        }

        return validCount;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int N = scanner.nextInt();
            int result = count_248_numbers(N);
            System.out.println(result);
        }
        scanner.close();
    }
}
