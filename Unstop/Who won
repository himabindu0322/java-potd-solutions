import java.util.Scanner;

public class Main {
    public static String determine_winner(int d, int k) {
        long dLong = d;
        long kLong = k;
        
        // Find largest integer 'a' such that 2 * (a * k)^2 <= d^2
        long a = 0;
        while (2 * (a + 1) * kLong * (a + 1) * kLong <= dLong * dLong) {
            a++;
        }
        
        // Coordinates of diagonal point reachable in 2a steps
        long x = a * kLong;
        long y = a * kLong;
        
        // Check if 1 more step to (x + k, y) is within distance d
        if ((x + kLong) * (x + kLong) + y * y <= dLong * dLong) {
            return "Ashish";
        } else {
            return "Utkarsh";
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int d = scanner.nextInt();
            int k = scanner.nextInt();
            String result = determine_winner(d, k);
            System.out.println(result);
        }
        scanner.close();
    }
}
