import java.util.Scanner;

public class Main {
    public static int count_lucky_strings(int N) {
        if (N == 1) return 2; // "p", "q"
        
        long MOD = 1000000007L;
        
        // dp[1] = 1, dp[2] = 1
        long prev2 = 1; // dp[i-2]
        long prev1 = 1; // dp[i-1]
        long current = 1;

        // Compute Fibonacci up to N
        for (int i = 3; i <= N; i++) {
            current = (prev1 + prev2) % MOD;
            prev2 = prev1;
            prev1 = current;
        }

        // Multiply by 2 for strings ending in 'p' vs 'q'
        long total = (2 * current) % MOD;
        return (int) total;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int N = scanner.nextInt();
            int result = count_lucky_strings(N);
            System.out.println(result);
        }
        scanner.close();
    }
}
