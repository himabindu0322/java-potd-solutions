import java.util.*;

public class Main {
    public static int findLargestNumber(List<Integer> arr) {
        // Sort the list to easily access the two smallest elements
        Collections.sort(arr);
        
        int firstMin = arr.get(0);
        int secondMin = arr.get(1);
        
        // Since secondMin >= firstMin, placing secondMin first gives the largest number
        return secondMin * 10 + firstMin;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int n = scanner.nextInt();
            List<Integer> arr = new ArrayList<>();
            for (int i = 0; i < n; i++) {
                arr.add(scanner.nextInt());
            }
            int result = findLargestNumber(arr);
            System.out.println(result);
        }
    }
}
