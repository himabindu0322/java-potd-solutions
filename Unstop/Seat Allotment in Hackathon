import java.util.*;

public class Main {
    static final int MOD = 1000000007;

    public static int seatAllotment(int n) {
        // If N is odd, total seats = 3 * N is odd, so impossible to pair everyone
        if (n % 2 != 0) {
            return 0;
        }

        // DP array to store ways for even values of N
        long[] dp = new long[n + 1];
        dp[0] = 1;
        
        if (n >= 2) {
            dp[2] = 3;
        }

        for (int i = 4; i <= n; i += 2) {
            // Recurrence: f(i) = 4 * f(i - 2) - f(i - 4)
            dp[i] = (4 * dp[i - 2] - dp[i - 4]) % MOD;
            
            // Handle negative result from modulo subtraction
            if (dp[i] < 0) {
                dp[i] += MOD;
            }
        }

        return (int) dp[n];
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        
        int n = scanner.nextInt();
        int result = seatAllotment(n);
        System.out.println(result);
    }
}
