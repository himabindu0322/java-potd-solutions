import java.util.Scanner;

public class Main {

    public static int userLogic(String s) {
        int open = 0;
        int invalidClose = 0;

        // Step 1: Calculate minimum insertions M required
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '(') {
                open++;
            } else if (c == ')') {
                if (open > 0) {
                    open--; // Matched with an existing '('
                } else {
                    invalidClose++; // Unmatched ')' requires an opening bracket
                }
            }
        }

        int M = invalidClose + open;

        if (M < 2) {
            return 0; // No prime numbers less than or equal to 0 or 1
        }

        // Step 2: Count prime numbers <= M using Sieve of Eratosthenes
        boolean[] isPrime = new boolean[M + 1];
        for (int i = 2; i <= M; i++) {
            isPrime[i] = true;
        }

        for (int p = 2; p * p <= M; p++) {
            if (isPrime[p]) {
                for (int i = p * p; i <= M; i += p) {
                    isPrime[i] = false;
                }
            }
        }

        int primeCount = 0;
        for (int i = 2; i <= M; i++) {
            if (isPrime[i]) {
                primeCount++;
            }
        }

        return primeCount;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextLine()) {
            String s = scanner.nextLine().trim();
            int result = userLogic(s);
            System.out.println(result);
        }
        scanner.close();
    }
}
