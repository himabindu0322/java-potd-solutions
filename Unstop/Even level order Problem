import java.util.*;

class Node {
    int data;
    Node next;
    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

public class Main {

    public static Node userLogic(Node head, int k) {
        if (head == null || k <= 0) return head;

        Node dummy = new Node(0);
        Node tail = dummy;
        Node curr = head;

        while (curr != null) {
            // Check if there are at least k nodes remaining
            Node temp = curr;
            int count = 0;
            int sum = 0;

            while (temp != null && count < k) {
                sum += temp.data;
                count++;
                temp = temp.next;
            }

            // If a complete group of size k exists
            if (count == k) {
                int mean = sum / k;

                // If mean is EVEN, add mean node
                if (mean % 2 == 0) {
                    tail.next = new Node(mean);
                    tail = tail.next;
                }
                // If mean is ODD, discard these k nodes

                curr = temp; // advance past the k nodes
            } else {
                // Fewer than k nodes remaining, attach remaining nodes as-is
                tail.next = curr;
                break;
            }
        }

        return dummy.next;
    }

    public static void printList(Node head) {
        Node current = head;
        while (current != null) {
            System.out.print(current.data + " --> ");
            current = current.next;
        }
        System.out.println("null");
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int k = scanner.nextInt();
        int n = scanner.nextInt();
        
        Node head = null;
        Node tail = null;
        
        for (int i = 0; i < n; i++) {
            int dataValue = scanner.nextInt();
            Node newNode = new Node(dataValue);
            if (head == null) {
                head = newNode;
                tail = newNode;
            } else {
                tail.next = newNode;
                tail = newNode;
            }
        }
        
        // Call user logic function
        Node modifiedHead = userLogic(head, k);
        
        // Print the resulting linked list
        printList(modifiedHead);
    }
}
