import java.util.Scanner;

public class Main {
    private static final int MOD = 1000000007;

    public static String userLogic(int N) {
        if (N <= 0) {
            return "1";
        }

        // Base case for N = 1
        long a = 1, e = 1, i = 1, o = 1, u = 1;

        // DP transitions for length 2 to N
        for (int k = 2; k <= N; k++) {
            long nextA = (e + u) % MOD;
            long nextE = (a + i) % MOD;
            long nextI = (e + o) % MOD;
            long nextO = (i + u) % MOD;
            long nextU = (a + o) % MOD;

            a = nextA;
            e = nextE;
            i = nextI;
            o = nextO;
            u = nextU;
        }

        long totalSum = (a + e + i + o + u) % MOD;

        // Return octal representation
        return Long.toOctalString(totalSum);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int N = scanner.nextInt();
            String result = userLogic(N);
            System.out.println(result);
        }
        scanner.close();
    }
}
