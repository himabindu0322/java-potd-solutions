import java.util.*;

public class Main {
    public static void canSelectPeople(int N, int K, int[] arr) {
        // dp[j] will be true if a subset with sum j is possible
        boolean[] dp = new boolean[K + 1];
        
        // Base case: sum of 0 is always possible (empty subset)
        dp[0] = true;
        
        // Process each person's number
        for (int num : arr) {
            // Traverse backwards from K to num to avoid using the same element multiple times
            for (int j = K; j >= num; j--) {
                if (dp[j - num]) {
                    dp[j] = true;
                }
            }
        }
        
        // If dp[K] is true, output YES, otherwise NO
        if (dp[K]) {
            System.out.println("YES");
        } else {
            System.out.println("NO");
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        
        int N = scanner.nextInt();
        int K = scanner.nextInt();
        int[] arr = new int[N];
        for (int i = 0; i < N; i++) {
            arr[i] = scanner.nextInt();
        }
        canSelectPeople(N, K, arr);
    }
}
