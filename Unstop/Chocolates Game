import java.util.*;

public class Main {
    public static int predictTheWinner(int[] nums) {
        int n = nums.length;
        
        // Mathematical Insight: When N is even, Player 1 can always win by choosing 
        // either all odd-indexed or all even-indexed elements.
        if (n % 2 == 0) {
            return 1;
        }

        // Dynamic Programming approach for general N (including odd lengths)
        // dp[i] stores the max score difference (Player 1 - Player 2) for subarray
        int[] dp = new int[n];
        
        for (int i = 0; i < n; i++) {
            dp[i] = nums[i];
        }
        
        for (int len = 2; len <= n; len++) {
            for (int i = 0; i <= n - len; i++) {
                int j = i + len - 1;
                dp[i] = Math.max(nums[i] - dp[i + 1], nums[j] - dp[i]);
            }
        }
        
        // If score difference is >= 0, Player 1 wins or ties
        return dp[0] >= 0 ? 1 : 0;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int n = scanner.nextInt();
            int[] nums = new int[n];
            for (int i = 0; i < n; i++) {
                nums[i] = scanner.nextInt();
            }
            int result = predictTheWinner(nums);
            System.out.println(result);
        }
        scanner.close();
    }
}
