import java.util.Scanner;

public class Main {
    public static int minInsertionsToPalindrome(String s) {
        if (s == null || s.isEmpty()) return 0;
        
        // Handle potential trailing whitespace from scanner.nextLine()
        s = s.trim(); 
        int n = s.length();
        
        String rev = new StringBuilder(s).reverse().toString();
        
        // DP array to store Longest Common Subsequence of s and reverse(s)
        int[][] dp = new int[n + 1][n + 1];
        
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                if (s.charAt(i - 1) == rev.charAt(j - 1)) {
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                } else {
                    dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                }
            }
        }
        
        int lpsLength = dp[n][n];
        return n - lpsLength;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextLine()) {
            String s = scanner.nextLine();
            int result = minInsertionsToPalindrome(s);
            System.out.println(result);
        }
        scanner.close();
    }
}
