import java.util.Scanner;

public class Main {
    public static void makeMeLucky(String S, String U) {
        StringBuilder sb = new StringBuilder();
        int uLen = U.length();

        for (int i = 0; i < S.length(); i++) {
            // Append current character to our stack-like StringBuilder
            sb.append(S.charAt(i));

            // If the buffer is long enough, check if the suffix matches U
            if (sb.length() >= uLen) {
                boolean match = true;
                for (int j = 0; j < uLen; j++) {
                    if (sb.charAt(sb.length() - uLen + j) != U.charAt(j)) {
                        match = false;
                        break;
                    }
                }

                // If match found, pop/delete the matching suffix
                if (match) {
                    sb.setLength(sb.length() - uLen);
                }
            }
        }

        // Print the resulting lucky string
        System.out.println(sb.toString());
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNext()) {
            String S = scanner.next();
            String U = scanner.next();
            makeMeLucky(S, U);
        }
    }
}
