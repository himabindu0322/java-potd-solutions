import java.util.Scanner;

class DoubleNode {
    int doubledata;
    DoubleNode doubleprev;
    DoubleNode doublenext;
    DoubleNode(int val) {
        doubledata = val;
        doubleprev = null;
        doublenext = null;
    }
}

class Node {
    int data;
    Node next;
    Node(int val) {
        data = val;
        next = null;
    }
}

public class Main {
    public static DoubleNode userLogic(int n, int m, int[][] arr) {
        DoubleNode head = null;
        DoubleNode tail = null;

        // Process even index rows first (0, 2, 4, ...)
        for (int i = 0; i < n; i += 2) {
            for (int j = 0; j < m; j++) {
                DoubleNode newNode = new DoubleNode(arr[i][j]);
                if (head == null) {
                    head = newNode;
                    tail = newNode;
                } else {
                    tail.doublenext = newNode;
                    newNode.doubleprev = tail;
                    tail = newNode;
                }
            }
        }

        // Process odd index rows next (1, 3, 5, ...)
        for (int i = 1; i < n; i += 2) {
            for (int j = 0; j < m; j++) {
                DoubleNode newNode = new DoubleNode(arr[i][j]);
                if (head == null) {
                    head = newNode;
                    tail = newNode;
                } else {
                    tail.doublenext = newNode;
                    newNode.doubleprev = tail;
                    tail = newNode;
                }
            }
        }

        return head;
    }

    public static void printDoubleLinkedList(DoubleNode head) {
        DoubleNode current = head;
        while (current != null) {
            System.out.print(current.doubledata + " <---> ");
            current = current.doublenext;
        }
        System.out.println("null");
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;

        int n = scanner.nextInt();
        int m = scanner.nextInt();

        int[][] arr = new int[n][m];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                arr[i][j] = scanner.nextInt();
            }
        }

        DoubleNode doubleLinkedListHead = userLogic(n, m, arr);
        printDoubleLinkedList(doubleLinkedListHead);
        
        scanner.close();
    }
}
