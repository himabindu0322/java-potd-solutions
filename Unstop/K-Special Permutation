import java.util.Scanner;

public class Main {
    private static final int MOD = 1000000007;

    public static int specialPermutations(int N, int K) {
        if (N <= 0) return 0;
        if (K >= N) K = N; // Max possible peaks cannot exceed N

        // dp[n][j] = number of permutations of length n with exactly j peaks
        long[][] dp = new long[N + 1][N + 1];

        // Base case: length 1 permutation [1] has 1 peak (1 > non-existent neighbors)
        dp[1][1] = 1;

        for (int n = 2; n <= N; n++) {
            for (int j = 1; j <= n; j++) {
                // Placing n adjacent to an existing peak maintains j peaks: 2 * j choices
                long keepPeaks = (dp[n - 1][j] * (2L * j)) % MOD;

                // Placing n anywhere else creates a new peak, increasing peaks from j-1 to j:
                // (n - 2 * (j - 1)) choices
                long newPeak = (dp[n - 1][j - 1] * (n - 2L * (j - 1))) % MOD;

                dp[n][j] = (keepPeaks + newPeak) % MOD;
            }
        }

        // Sum up permutations with at most K peaks
        long totalSpecialPermutations = 0;
        for (int j = 1; j <= Math.min(K, N); j++) {
            totalSpecialPermutations = (totalSpecialPermutations + dp[N][j]) % MOD;
        }

        return (int) totalSpecialPermutations;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int N = scanner.nextInt();
            int K = scanner.nextInt();
            System.out.println(specialPermutations(N, K));
        }
        scanner.close();
    }
}
