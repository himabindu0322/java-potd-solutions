import java.util.Scanner;

public class Main {
    public static int[] user_logic(int n) {
        // Base case: 0 mutual friends requires 0 nodes.
        if (n == 0) {
            return new int[]{0, 0};
        }
        
        int[] dp = new int[n + 1];
        int INF = 1_000_000_000;
        
        // Initialize DP array with a high value 
        for (int j = 1; j <= n; j++) {
            dp[j] = INF;
        }
        dp[0] = 0;
        
        // Unbounded Knapsack DP: iterate through all possible SCC sizes 'i'
        for (int i = 2; ; i++) {
            int val = i * (i - 1) / 2;
            
            // Break early when the mutual pairs formed by 'i' nodes exceeds the total target 'n'
            if (val > n) {
                break;
            }
            
            for (int j = val; j <= n; j++) {
                int cand = dp[j - val] + i;
                if (cand < dp[j]) {
                    dp[j] = cand;
                }
            }
        }
        
        int min_people = dp[n];
        
        // Calculate Maximum one-way pairs using combination logic
        // Formula: Total possible unique pairs minus mutual pairs
        long max_one_way_pairs = (long) min_people * (min_people - 1) / 2 - n;
        
        return new int[]{min_people, (int) max_one_way_pairs};
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int n = scanner.nextInt();
            int[] result = user_logic(n);
            System.out.println(result[0] + " " + result[1]);
        }
        scanner.close();
    }
}
