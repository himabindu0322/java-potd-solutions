import java.util.*;

public class Main {
    public static void userLogic(int n, int[] arr) {
        int[] result = new int[n];
        
        // Pass 1: Compute prefix products
        result[0] = 1;
        for (int i = 1; i < n; i++) {
            result[i] = result[i - 1] * arr[i - 1];
        }
        
        // Pass 2: Multiply by suffix products from right to left
        int suffixProduct = 1;
        for (int i = n - 1; i >= 0; i--) {
            result[i] = result[i] * suffixProduct;
            suffixProduct *= arr[i];
        }
        
        // Copy the computed products back into the original array
        for (int i = 0; i < n; i++) {
            arr[i] = result[i];
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        
        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        
        userLogic(n, arr);
        
        // Output each result on a new line as specified
        for (int res : arr) {
            System.out.println(res);
        }
    }
}
