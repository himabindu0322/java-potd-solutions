import java.util.Scanner;

public class Main {
    public static int countXorSetbitTriplets(int N) {
        int count = 0;

        // Iterate through all unique pairs (A, B) such that A < B <= N
        for (int A = 1; A <= N; A++) {
            int bitsA = Integer.bitCount(A);

            for (int B = A + 1; B <= N; B++) {
                int bitsB = Integer.bitCount(B);

                // Quick prune: set bit count must match
                if (bitsA != bitsB) {
                    continue;
                }

                int C = A ^ B;

                // Ensure C > B to avoid counting permutations like (B, A, C) or duplicates
                if (C > B && C <= N) {
                    if (Integer.bitCount(C) == bitsA) {
                        count++;
                    }
                }
            }
        }

        return count;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int N = scanner.nextInt();
            int result = countXorSetbitTriplets(N);
            System.out.println(result);
        }
        scanner.close();
    }
}
