import java.util.*;

class Main {
    private static final int MOD = 1_000_000_007;

    public static int user_logic(int n, int[] heights) {
        if (n <= 1) return 1;

        // dp[j] stores the number of valid permutations of prefix length 'i'
        // where the last element is at relative rank 'j' (1-indexed)
        long[] dp = new long[n + 1];
        dp[1] = 1;

        for (int i = 2; i <= n; i++) {
            long[] nextDp = new long[n + 1];
            long[] pref = new long[n + 1];

            // Build prefix sums of current DP row
            for (int j = 1; j < i; j++) {
                pref[j] = (pref[j - 1] + dp[j]) % MOD;
            }

            int relation; // 1 for <, -1 for >, 0 for =
            if (heights[i - 2] < heights[i - 1]) {
                relation = 1;  // P[i-1] < P[i] -> rank of P[i] must be > rank of P[i-1]
            } else if (heights[i - 2] > heights[i - 1]) {
                relation = -1; // P[i-1] > P[i] -> rank of P[i] must be <= rank of P[i-1]
            } else {
                relation = 0;  // No constraint
            }

            for (int j = 1; j <= i; j++) {
                if (relation == 1) {
                    // sum_{k=1}^{j-1} dp[k]
                    nextDp[j] = pref[j - 1];
                } else if (relation == -1) {
                    // sum_{k=j}^{i-1} dp[k]
                    nextDp[j] = (pref[i - 1] - pref[j - 1] + MOD) % MOD;
                } else {
                    // sum_{k=1}^{i-1} dp[k]
                    nextDp[j] = pref[i - 1];
                }
            }

            dp = nextDp;
        }

        long total = 0;
        for (int j = 1; j <= n; j++) {
            total = (total + dp[j]) % MOD;
        }

        return (int) total;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int n = scanner.nextInt();
            int[] heights = new int[n];
            for (int i = 0; i < n; i++) {
                heights[i] = scanner.nextInt();
            }
            int result = user_logic(n, heights);
            System.out.println(result);
        }
        scanner.close();
    }
}
