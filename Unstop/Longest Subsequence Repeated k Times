import java.util.*;

public class Main {
    public static String longestSubsequenceRepeatedK(String s, int k) {
        int[] freq = new int[26];
        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        // Only keep characters that appear at least k times
        List<Character> validChars = new ArrayList<>();
        for (int i = 0; i < 26; i++) {
            if (freq[i] >= k) {
                validChars.add((char) ('a' + i));
            }
        }

        Queue<String> queue = new LinkedList<>();
        queue.add("");
        String ans = "";

        while (!queue.isEmpty()) {
            String curr = queue.poll();

            for (char c : validChars) {
                String next = curr + c;
                if (isKSubsequence(s, next, k)) {
                    ans = next; // BFS ensures we keep updating to longer/lexicographically larger string
                    queue.add(next);
                }
            }
        }

        return ans;
    }

    // Helper method to check if (sub * k) is a subsequence of string s
    private static boolean isKSubsequence(String s, String sub, int k) {
        int index = 0;
        int count = 0;
        int subLen = sub.length();

        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) == sub.charAt(index)) {
                index++;
                if (index == subLen) {
                    index = 0;
                    count++;
                    if (count == k) return true;
                }
            }
        }

        return false;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextLine()) {
            String s = scanner.nextLine().trim();
            if (scanner.hasNextInt()) {
                int k = scanner.nextInt();
                String result = longestSubsequenceRepeatedK(s, k);
                System.out.println(result);
            }
        }
        scanner.close();
    }
}
