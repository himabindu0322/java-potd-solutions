import java.util.Arrays;
import java.util.Scanner;

public class Main {
    public static String getSmallestString(int n, int k) {
        char[] result = new char[n];
        
        // Fill the array with 'a' initially (each 'a' contributes 1 to total value)
        Arrays.fill(result, 'a');
        
        // We have already assigned 'a' to all positions, so remaining value is k - n
        int remainingValue = k - n;
        
        // Start filling larger characters from the end (right to left)
        int index = n - 1;
        while (remainingValue > 0 && index >= 0) {
            // Add as much as possible up to 'z' (which adds 25 to 'a')
            int add = Math.min(25, remainingValue);
            result[index] = (char) ('a' + add);
            remainingValue -= add;
            index--;
        }
        
        return new String(result);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int n = scanner.nextInt();
            int k = scanner.nextInt();
            String result = getSmallestString(n, k);
            System.out.println(result);
        }
        scanner.close();
    }
}
