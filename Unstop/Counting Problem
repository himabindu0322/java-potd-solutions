import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.IOException;
import java.util.StringTokenizer;

public class Main {
    static int countUniqueNumbers(int[] arr) {
        if (arr == null || arr.length == 0) return 0;
        
        // Find the maximum value to size our frequency array
        int maxVal = 0;
        for (int num : arr) {
            if (num > maxVal) {
                maxVal = num;
            }
        }
        
        // Count frequencies of each number
        int[] freq = new int[maxVal + 1];
        for (int num : arr) {
            freq[num]++;
        }
        
        int uniqueCount = 0;
        
        // Process numbers from largest to smallest
        for (int x = maxVal; x >= 1; x--) {
            if (freq[x] == 0) {
                continue;
            }
            
            if (freq[x] == 1) {
                // Maximum element is unique
                uniqueCount++;
                int half = x / 2;
                if (half > 0) {
                    freq[half]++; // Insert half into the collection
                }
            }
            // If freq[x] > 1, all occurrences are removed (we simply do nothing and move on)
            freq[x] = 0;
        }
        
        return uniqueCount;
    }

    public static void main(String[] args) throws IOException {
        // Fast I/O for N <= 10^6
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String line = br.readLine();
        if (line == null || line.trim().isEmpty()) return;
        
        int n = Integer.parseInt(line.trim());
        int[] arr = new int[n];
        
        line = br.readLine();
        if (line != null) {
            StringTokenizer st = new StringTokenizer(line);
            for (int i = 0; i < n; i++) {
                if (st.hasMoreTokens()) {
                    arr[i] = Integer.parseInt(st.nextToken());
                }
            }
        }
        
        int result = countUniqueNumbers(arr);
        System.out.println(result);
    }
}
