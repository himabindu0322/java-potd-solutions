import java.util.Scanner;

public class Main {
    private static final int MOD = 998244353;

    public static int user_logic(int N) {
        if (N <= 0) return 0;

        // dp[d] stores the number of valid sequences ending with digit d
        long[] dp = new long[10];

        // Base case for length 1: 1 way for each digit from 1 to 9
        for (int d = 1; d <= 9; d++) {
            dp[d] = 1;
        }

        // DP state transitions from length 2 to N
        for (int i = 2; i <= N; i++) {
            long[] nextDp = new long[10];

            for (int d = 1; d <= 9; d++) {
                long ways = dp[d]; // same digit
                if (d - 1 >= 1) ways = (ways + dp[d - 1]) % MOD; // digit - 1
                if (d + 1 <= 9) ways = (ways + dp[d + 1]) % MOD; // digit + 1

                nextDp[d] = ways;
            }

            dp = nextDp;
        }

        // Sum the results for all ending digits
        long totalCount = 0;
        for (int d = 1; d <= 9; d++) {
            totalCount = (totalCount + dp[d]) % MOD;
        }

        return (int) totalCount;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (scanner.hasNextInt()) {
            int N = scanner.nextInt();
            System.out.println(user_logic(N));
        }
        scanner.close();
    }
}
