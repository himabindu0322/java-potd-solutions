import java.util.*;

public class Main {
    public static int user_logic(int N, int K, int[] arr) {
        // dp[i] stores the minimum cost to partition the first i elements
        int[] dp = new int[N + 1];
        
        // Initialize dp array with a large value
        Arrays.fill(dp, Integer.MAX_VALUE);
        dp[0] = 0; // Base case: 0 elements cost 0

        for (int i = 1; i <= N; i++) {
            int maxVal = 0;
            // Look back up to K elements to form the last subarray
            for (int len = 1; len <= K && i - len >= 0; len++) {
                // Maintain the maximum value in the current subarray arr[i - len ... i - 1]
                maxVal = Math.max(maxVal, arr[i - len]);
                
                // Transition state
                dp[i] = Math.min(dp[i], dp[i - len] + maxVal);
            }
        }

        return dp[N];
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int N = scanner.nextInt();
        int K = scanner.nextInt();
        int[] arr = new int[N];
        for (int i = 0; i < N; i++) {
            arr[i] = scanner.nextInt();
        }
        scanner.close();
        
        // Call user logic function and print the output
        int result = user_logic(N, K, arr);
        System.out.println(result);
    }
}
