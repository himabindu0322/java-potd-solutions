import java.util.*;

class Main {
    public static long user_logic(int[] arr) {
        int n = arr.length;
        long totalDeviation = 0;
        long maxReduction = 0;

        for (int i = 1; i < n; i++) {
            long diff = arr[i] - arr[i - 1];
            long currentTerm = diff * diff;
            totalDeviation += currentTerm;

            // Compute reduction by inserting optimal x between arr[i-1] and arr[i]
            long newTerm;
            if (diff % 2 == 0) {
                newTerm = currentTerm / 2;
            } else {
                newTerm = (currentTerm + 1) / 2;
            }

            long reduction = currentTerm - newTerm;
            if (reduction > maxReduction) {
                maxReduction = reduction;
            }
        }

        return totalDeviation - maxReduction;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        int[] arr = new int[N];
        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }
        
        // Changed return type handling to long to prevent overflow for N = 10^6
        long result = user_logic(arr);
        System.out.println(result);
    }
}
