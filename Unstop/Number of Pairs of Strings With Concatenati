import java.util.*;

public class Main {
    public static int num_of_pairs(List<String> nums, String target) {
        int count = 0;
        int n = nums.size();

        // Check every ordered pair (i, j) with i != j
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (i != j) {
                    if ((nums.get(i) + nums.get(j)).equals(target)) {
                        count++;
                    }
                }
            }
        }

        return count;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        
        int n = scanner.nextInt();
        List<String> arr = new ArrayList<>();
        
        // Read elements safely handling both space-separated and line-separated inputs
        for (int i = 0; i < n; i++) {
            if (scanner.hasNext()) {
                arr.add(scanner.next());
            }
        }
        
        if (scanner.hasNext()) {
            String target = scanner.next();
            int result = num_of_pairs(arr, target);
            System.out.println(result);
        }
        
        scanner.close();
    }
}
