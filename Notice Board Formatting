import java.util.*;

public class Solution {

    public static List<String> fullJustify(String[] words, int maxWidth) {
        List<String> result = new ArrayList<>();
        int i = 0;
        int n = words.length;

        while (i < n) {
            int j = i + 1;
            int lineLength = words[i].length();

            // Find how many words fit into the current line
            while (j < n && lineLength + 1 + words[j].length() <= maxWidth) {
                lineLength += 1 + words[j].length();
                j++;
            }

            StringBuilder sb = new StringBuilder();
            int numWords = j - i;

            // If it's the last line or the line only contains one word (left-justified)
            if (j == n || numWords == 1) {
                for (int k = i; k < j; k++) {
                    sb.append(words[k]);
                    if (k < j - 1) sb.append(" ");
                }
                while (sb.length() < maxWidth) {
                    sb.append(" ");
                }
            } else {
                // Fully justified line
                int totalCharLen = 0;
                for (int k = i; k < j; k++) {
                    totalCharLen += words[k].length();
                }

                int totalSpaces = maxWidth - totalCharLen;
                int gaps = numWords - 1;
                int spacesPerGap = totalSpaces / gaps;
                int extraSpaces = totalSpaces % gaps;

                for (int k = i; k < j; k++) {
                    sb.append(words[k]);
                    if (k < j - 1) {
                        int spacesToApply = spacesPerGap + (k - i < extraSpaces ? 1 : 0);
                        sb.append(" ".repeat(spacesToApply));
                    }
                }
            }

            result.add(sb.toString());
            i = j;
        }

        return result;
    }
}
