public class Solution {

    public static int shortestUnsortedSubarray(int[] marks) {
        int n = marks.length;
        int maxSeen = Integer.MIN_VALUE;
        int minSeen = Integer.MAX_VALUE;
        
        int right = -1;
        int left = -1;

        // Traverse left to right to find the right boundary
        for (int i = 0; i < n; i++) {
            if (marks[i] < maxSeen) {
                right = i;
            } else {
                maxSeen = marks[i];
            }
        }

        // Traverse right to left to find the left boundary
        for (int i = n - 1; i >= 0; i--) {
            if (marks[i] > minSeen) {
                left = i;
            } else {
                minSeen = marks[i];
            }
        }

        // If the array is already sorted
        if (right == -1) {
            return 0;
        }

        return right - left + 1;
    }
}
