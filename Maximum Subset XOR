class Solution {
    public int maxSubsetXOR(int[] arr) {
        int index = 0;
        int n = arr.length;

        // Process bits from MSB (bit 20 for arr[i] <= 10^6) down to LSB (bit 0)
        for (int bit = 20; bit >= 0; bit--) {
            int maxIdx = index;
            int maxElement = -1;

            // Find the element with the highest value having the current bit set
            for (int i = index; i < n; i++) {
                if ((arr[i] & (1 << bit)) != 0 && arr[i] > maxElement) {
                    maxElement = arr[i];
                    maxIdx = i;
                }
            }

            // If no element has this bit set, move to the next bit
            if (maxElement == -1) {
                continue;
            }

            // Swap the chosen element to the current index position
            int temp = arr[index];
            arr[index] = arr[maxIdx];
            arr[maxIdx] = temp;

            maxIdx = index;

            // Eliminate this bit from all other numbers
            for (int i = 0; i < n; i++) {
                if (i != maxIdx && (arr[i] & (1 << bit)) != 0) {
                    arr[i] ^= arr[maxIdx];
                }
            }

            index++;
        }

        // Calculate maximum XOR sum by taking XOR of all basis elements
        int res = 0;
        for (int i = 0; i < n; i++) {
            res ^= arr[i];
        }

        return res;
    }
}
