class Solution {
    public int zigzagSequence(int[][] mat) {
        int n = mat.length;
        if (n == 0) return 0;
        if (n == 1) {
            int maxVal = mat[0][0];
            for (int j = 1; j < mat[0].length; j++) {
                maxVal = Math.max(maxVal, mat[0][j]);
            }
            return maxVal;
        }

        // dp[j] stores the maximum zigzag sum ending at column j of the current row
        int[] dp = new int[n];
        for (int j = 0; j < n; j++) {
            dp[j] = mat[0][j];
        }

        for (int i = 1; i < n; i++) {
            // Find max and second max from the previous row's dp array
            int max1 = -1, max2 = -1;
            int max1Col = -1;

            for (int j = 0; j < n; j++) {
                if (dp[j] > max1) {
                    max2 = max1;
                    max1 = dp[j];
                    max1Col = j;
                } else if (dp[j] > max2) {
                    max2 = dp[j];
                }
            }

            // Compute new DP values for row i
            int[] nextDp = new int[n];
            for (int j = 0; j < n; j++) {
                // If picking the same column as max1, we must use max2
                int prevMax = (j == max1Col) ? max2 : max1;
                nextDp[j] = mat[i][j] + prevMax;
            }

            dp = nextDp;
        }

        // Return the maximum sum from the last row
        int result = 0;
        for (int val : dp) {
            result = Math.max(result, val);
        }

        return result;
    }
}
