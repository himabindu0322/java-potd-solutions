class Solution {
    public int countSubarray(int[] arr, int l, int r) {
        return (int) (countAtMost(arr, r) - countAtMost(arr, l - 1));
    }

    // Helper function to count subarrays with sum <= target
    private long countAtMost(int[] arr, long target) {
        if (target < 0) return 0;

        int left = 0;
        long currentSum = 0;
        long count = 0;

        for (int right = 0; right < arr.length; right++) {
            currentSum += arr[right];

            // Shrink window if sum exceeds target
            while (left <= right && currentSum > target) {
                currentSum -= arr[left];
                left++;
            }

            // All subarrays ending at 'right' starting from 'left' to 'right' are valid
            count += (right - left + 1);
        }

        return count;
    }
}
