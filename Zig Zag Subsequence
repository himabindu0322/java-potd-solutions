public class Solution {
    public static int zigZagSubsequence(int[] tokenArray) {
        if (tokenArray == null || tokenArray.length == 0) {
            return 0;
        }

        int up = 1;
        int down = 1;

        for (int i = 1; i < tokenArray.length; i++) {
            if (tokenArray[i] > tokenArray[i - 1]) {
                up = down + 1;
            } else if (tokenArray[i] < tokenArray[i - 1]) {
                down = up + 1;
            }
        }

        return Math.max(up, down);
    }
}
