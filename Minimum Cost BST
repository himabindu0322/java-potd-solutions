import java.util.*;
import java.io.*; 

public class Solution {
    public static int minCostBST(int arr[], int freq[]) {
        int n = arr.length;
        if (n == 0) return 0;

        // Prefix sum array to quickly calculate sum of frequencies in range [i, j]
        long[] prefixSum = new long[n + 1];
        for (int i = 0; i < n; i++) {
            prefixSum[i + 1] = prefixSum[i] + freq[i];
        }

        // dp[i][j] stores the minimum cost of BST for sub-array arr[i..j]
        long[][] dp = new long[n][n];

        // Chain length L goes from 1 to n
        for (int L = 1; L <= n; L++) {
            for (int i = 0; i <= n - L; i++) {
                int j = i + L - 1;

                dp[i][j] = Long.MAX_VALUE;

                // Sum of frequencies from index i to j
                long sumFreq = prefixSum[j + 1] - prefixSum[i];

                // Try making each element arr[r] in range [i, j] the root
                for (int r = i; r <= j; r++) {
                    long leftCost = (r > i) ? dp[i][r - 1] : 0;
                    long rightCost = (r < j) ? dp[r + 1][j] : 0;

                    long totalCost = leftCost + rightCost + sumFreq;
                    dp[i][j] = Math.min(dp[i][j], totalCost);
                }
            }
        }

        return (int) dp[0][n - 1];
    }
}
