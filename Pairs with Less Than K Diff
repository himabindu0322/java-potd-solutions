import java.util.Arrays;

class Solution {
    public static int countPairs(int arr[], int k) {
        // Step 1: Sort the array
        Arrays.sort(arr);
        
        int n = arr.length;
        int left = 0;
        int count = 0;
        
        // Step 2: Sliding window to count valid pairs
        for (int right = 0; right < n; right++) {
            while (arr[right] - arr[left] >= k) {
                left++;
            }
            // Number of elements in window [left, right-1]
            count += (right - left);
        }
        
        return count;
    }
}
