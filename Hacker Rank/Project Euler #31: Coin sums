import java.io.*;
import java.util.*;

public class Solution {

    private static final int MOD = 1_000_000_007;
    private static final int MAX_N = 100_000;

    public static void main(String[] args) throws IOException {
        // Fast I/O using BufferedReader and StringBuilder
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String line = br.readLine();
        if (line == null || line.trim().isEmpty()) return;

        int T = Integer.parseInt(line.trim());

        // Available coin denominations in pence
        int[] coins = {1, 2, 5, 10, 20, 50, 100, 200};

        // Precompute DP array up to MAX_N
        long[] dp = new long[MAX_N + 1];
        dp[0] = 1; // Base case: 1 way to make amount 0

        for (int coin : coins) {
            for (int i = coin; i <= MAX_N; i++) {
                dp[i] = (dp[i] + dp[i - coin]) % MOD;
            }
        }

        // Process all test cases using StringBuilder for fast output
        StringBuilder sb = new StringBuilder();
        for (int t = 0; t < T; t++) {
            int N = Integer.parseInt(br.readLine().trim());
            sb.append(dp[N]).append("\n");
        }

        System.out.print(sb.toString());
    }
}
