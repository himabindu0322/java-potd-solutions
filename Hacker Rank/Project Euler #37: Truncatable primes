import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        
        int n = sc.nextInt();
        
        // Step 1: Precompute primes using Sieve of Eratosthenes up to N
        boolean[] isPrime = new boolean[n];
        Arrays.fill(isPrime, true);
        if (n > 0) isPrime[0] = false;
        if (n > 1) isPrime[1] = false;
        
        for (int p = 2; p * p < n; p++) {
            if (isPrime[p]) {
                for (int i = p * p; i < n; i += p) {
                    isPrime[i] = false;
                }
            }
        }

        long sum = 0;

        // Step 2: Iterate through candidate primes (truncatable primes must be >= 11)
        for (int i = 11; i < n; i++) {
            if (isPrime[i] && isTruncatable(i, isPrime)) {
                sum += i;
            }
        }

        // Output the result
        System.out.println(sum);
    }

    private static boolean isTruncatable(int num, boolean[] isPrime) {
        // Check Right-Truncation (removing digits from right to left)
        int temp = num / 10;
        while (temp > 0) {
            if (!isPrime[temp]) {
                return false;
            }
            temp /= 10;
        }

        // Check Left-Truncation (removing digits from left to right)
        int divisor = 10;
        while (divisor < num) {
            int subNum = num % divisor;
            if (!isPrime[subNum]) {
                return false;
            }
            divisor *= 10;
        }

        return true;
    }
}
