import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;

        int N = scanner.nextInt();

        // Precompute powers of digits 0-9 for efficiency
        int[] powers = new int[10];
        for (int i = 0; i < 10; i++) {
            powers[i] = (int) Math.pow(i, N);
        }

        // Upper limit calculation: (N + 1) * 9^N
        int limit = (N + 1) * powers[9];

        long totalSum = 0;

        // Numbers must be at least 2 digits long (starts at 10)
        for (int i = 10; i <= limit; i++) {
            int temp = i;
            int digitSum = 0;

            while (temp > 0) {
                digitSum += powers[temp % 10];
                temp /= 10;
            }

            if (digitSum == i) {
                totalSum += i;
            }
        }

        System.out.println(totalSum);
    }
}
