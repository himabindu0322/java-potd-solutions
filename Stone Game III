class Solution {
    public String stoneGameIII(int[] stoneValue) {
        int n = stoneValue.length;
        // dp[i] stores the max net advantage for the player starting at index i
        int[] dp = new int[n + 1];
        
        // Base case: dp[n] = 0 (no stones left)
        
        // Traverse backwards from the end of the array
        for (int i = n - 1; i >= 0; i--) {
            int maxAdvantage = Integer.MIN_VALUE;
            int currentSum = 0;
            
            // Try taking 1, 2, or 3 stones
            for (int k = 0; k < 3 && i + k < n; k++) {
                currentSum += stoneValue[i + k];
                int nextPlayerAdvantage = dp[i + k + 1];
                maxAdvantage = Math.max(maxAdvantage, currentSum - nextPlayerAdvantage);
            }
            
            dp[i] = maxAdvantage;
        }
        
        // dp[0] represents Alice's score minus Bob's score
        if (dp[0] > 0) {
            return "Alice";
        } else if (dp[0] < 0) {
            return "Bob";
        } else {
            return "Tie";
        }
    }
}
