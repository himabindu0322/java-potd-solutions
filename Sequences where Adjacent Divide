class Solution {
    public int count(int n, int m) {
        // dp[i][j] stores the number of sequences of length i ending with value j
        int[][] dp = new int[n + 1][m + 1];

        // Base case: sequences of length 1
        for (int j = 1; j <= m; j++) {
            dp[1][j] = 1;
        }

        // Fill DP table for lengths 2 to n
        for (int i = 2; i <= n; i++) {
            for (int curr = 1; curr <= m; curr++) {
                for (int prev = 1; prev <= m; prev++) {
                    // Check if adjacent elements divide each other
                    if (curr % prev == 0 || prev % curr == 0) {
                        dp[i][curr] += dp[i - 1][prev];
                    }
                }
            }
        }

        // Total sequences of length n ending at any value from 1 to m
        int totalCount = 0;
        for (int j = 1; j <= m; j++) {
            totalCount += dp[n][j];
        }

        return totalCount;
    }
}
