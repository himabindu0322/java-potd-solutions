import java.util.*;

public class Solution {

    public static int trap(ArrayList<Integer> height) {
        if (height == null || height.size() == 0) {
            return 0;
        }

        int left = 0;
        int right = height.size() - 1;
        
        int leftMax = 0;
        int rightMax = 0;
        
        int totalWater = 0;

        while (left < right) {
            if (height.get(left) <= height.get(right)) {
                if (height.get(left) >= leftMax) {
                    leftMax = height.get(left);
                } else {
                    totalWater += leftMax - height.get(left);
                }
                left++;
            } else {
                if (height.get(right) >= rightMax) {
                    rightMax = height.get(right);
                } else {
                    totalWater += rightMax - height.get(right);
                }
                right--;
            }
        }

        return totalWater;
    }
}
