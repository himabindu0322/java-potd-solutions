class Solution {
    public int maxTask(int[] h, int[] l) {
        int n = h.length;
        if (n == 0) return 0;
        
        // Base case for Day 0
        int prev2 = 0;                     // Equivalent to dp[-1]
        int prev1 = Math.max(h[0], l[0]); // Equivalent to dp[0]
        
        for (int i = 1; i < n; i++) {
            // Option 1: Perform low-effort task today
            int doLow = prev1 + l[i];
            
            // Option 2: Perform high-effort task today (requires skipping day i-1)
            int doHigh = prev2 + h[i];
            
            int current = Math.max(doLow, doHigh);
            
            // Move state forward
            prev2 = prev1;
            prev1 = current;
        }
        
        return prev1;
    }
}
