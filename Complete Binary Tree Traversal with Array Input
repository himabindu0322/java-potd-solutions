import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;

class Solution {
    public ArrayList<ArrayList<Integer>> levelSort(int[] arr) {
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        int n = arr.length;
        int index = 0;
        int levelSize = 1;

        while (index < n) {
            ArrayList<Integer> currentLevel = new ArrayList<>();
            
            // Extract elements for the current level
            int count = 0;
            while (index < n && count < levelSize) {
                currentLevel.add(arr[index]);
                index++;
                count++;
            }
            
            // Sort the current level in ascending order
            Collections.sort(currentLevel);
            
            // Add the sorted level to the result
            result.add(currentLevel);
            
            // The max number of nodes in the next level doubles
            levelSize *= 2;
        }

        return result;
    }
}
