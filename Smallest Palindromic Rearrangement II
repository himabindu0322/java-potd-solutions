import java.util.*;

class Solution {
    private static final long MAX_K = 1_000_001; // Cap to prevent arithmetic overflow

    public String smallestPalindrome(String s, int k) {
        int[] freq = new int[26];
        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        // Divide frequency by 2 for the left half, track middle character
        int[] halfFreq = new int[26];
        char midChar = 0;
        for (int i = 0; i < 26; i++) {
            halfFreq[i] = freq[i] / 2;
            if (freq[i] % 2 != 0) {
                midChar = (char) ('a' + i);
            }
        }

        // Check if total distinct permutations >= k
        long totalPermutations = countPermutations(halfFreq);
        if (totalPermutations < k) {
            return "";
        }

        // Build the left half character by character
        int halfLen = 0;
        for (int f : halfFreq) halfLen += f;

        StringBuilder leftHalf = new StringBuilder();
        long currentK = k;

        for (int pos = 0; pos < halfLen; pos++) {
            for (int i = 0; i < 26; i++) {
                if (halfFreq[i] == 0) continue;

                // Pick character 'a' + i temporarily
                halfFreq[i]--;
                long arrangements = countPermutations(halfFreq);

                if (arrangements >= currentK) {
                    // This character is valid for the current position
                    leftHalf.append((char) ('a' + i));
                    break;
                } else {
                    // Skip 'arrangements' permutations and decrease currentK
                    currentK -= arrangements;
                    halfFreq[i]++; // Backtrack
                }
            }
        }

        // Assemble the full palindrome
        String left = leftHalf.toString();
        String right = new StringBuilder(left).reverse().toString();

        if (midChar != 0) {
            return left + midChar + right;
        } else {
            return left + right;
        }
    }

    // Calculates multinomial coefficient: L! / (c1! * c2! * ... * c26!)
    private long countPermutations(int[] counts) {
        int total = 0;
        for (int c : counts) total += c;

        long res = 1;
        for (int c : counts) {
            if (c == 0) continue;
            res = multiplyAndCap(res, nCr(total, c));
            total -= c;
        }
        return res;
    }

    // Helper: Combinations nCr = n! / (r! * (n-r)!)
    private long nCr(int n, int r) {
        if (r < 0 || r > n) return 0;
        if (r == 0 || r == n) return 1;
        if (r > n - r) r = n - r;

        long res = 1;
        for (int i = 1; i <= r; i++) {
            res = res * (n - i + 1) / i;
            if (res >= MAX_K) return MAX_K;
        }
        return res;
    }

    private long multiplyAndCap(long a, long b) {
        if (a == 0 || b == 0) return 0;
        if (a >= MAX_K || b >= MAX_K) return MAX_K;
        long prod = a * b;
        return prod >= MAX_K ? MAX_K : prod;
    }
}
