/* Structure of Binary Tree Node
class Node {
    int data;
    Node left, right;

    Node(int val) {
        data = val;
        left = right = null;
    }
} */

class Solution {
    private int preIndex = 0;

    public Node constructBinaryTree(int[] pre, int[] preMirror) {
        preIndex = 0;
        return buildTree(pre, preMirror, 0, preMirror.length - 1);
    }

    private Node buildTree(int[] pre, int[] preMirror, int mirrorStart, int mirrorEnd) {
        // Base cases
        if (preIndex >= pre.length || mirrorStart > mirrorEnd) {
            return null;
        }

        // The current element in pre[] is the root of this subtree
        Node root = new Node(pre[preIndex++]);

        // If the current node has no children (leaf node) or no more elements in mirror range
        if (mirrorStart == mirrorEnd || preIndex >= pre.length) {
            return root;
        }

        // The next element in pre[] is the root of the left subtree.
        // Search for this element in preMirror[] to find the boundaries.
        int leftChildIndex = mirrorStart;
        while (leftChildIndex <= mirrorEnd) {
            if (preMirror[leftChildIndex] == pre[preIndex]) {
                break;
            }
            leftChildIndex++;
        }

        // Recursively construct left and right subtrees
        if (leftChildIndex <= mirrorEnd) {
            // Left subtree exists in preMirror from leftChildIndex to mirrorEnd
            root.left = buildTree(pre, preMirror, leftChildIndex, mirrorEnd);
            
            // Right subtree exists in preMirror from mirrorStart + 1 to leftChildIndex - 1
            root.right = buildTree(pre, preMirror, mirrorStart + 1, leftChildIndex - 1);
        }

        return root;
    }
}
