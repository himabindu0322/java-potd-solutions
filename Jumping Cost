import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		if (sc.hasNextInt()) {
			int t = sc.nextInt();
			
			while (t-- > 0) {
				int n = sc.nextInt();
				int[] a = new int[n + 1];
				for (int i = 1; i <= n; i++) {
					a[i] = sc.nextInt();
				}
				
				long[] dp = new long[n + 1];
				Arrays.fill(dp, Long.MIN_VALUE / 2);
				dp[1] = 0; // Starting index 1 with 0 balance
				
				long maxBalance = 0; // Balance can be 0 if no jumps are taken
				
				for (int j = 2; j <= n; j++) {
					for (int i = 1; i < j; i++) {
						if (dp[i] != Long.MIN_VALUE / 2) {
							dp[j] = Math.max(dp[j], dp[i] + a[j] - j + i);
						}
					}
					maxBalance = Math.max(maxBalance, dp[j]);
				}
				
				System.out.println(maxBalance);
			}
		}
		sc.close();
	}
}
