import java.util.Arrays;

class Solution {
    public int minimumPushes(String word) {
        // Step 1: Count frequency of each lowercase English letter
        int[] freq = new int[26];
        for (char c : word.toCharArray()) {
            freq[c - 'a']++;
        }

        // Step 2: Sort frequencies in ascending order
        Arrays.sort(freq);

        int totalPushes = 0;
        int distinctCharCount = 0;

        // Step 3: Iterate backwards (from highest frequency to lowest)
        for (int i = 25; i >= 0; i--) {
            if (freq[i] == 0) break; // No more characters to process

            // Determine key push cost based on current character rank
            int pushMultiplier = (distinctCharCount / 8) + 1;
            totalPushes += freq[i] * pushMultiplier;

            distinctCharCount++;
        }

        return totalPushes;
    }
}
